[gd_scene load_steps=6 format=3]

; Playable stage host.
;
; Game node: root Control with game_boot.gd, boots ChapterFlow on ready.
; GameBackground: solid fill so the grid is visible against the canvas.
; ChapterFlow: the ten-step state machine driving every stage.
; ResourceStatusBar: six-resource bar (resource_bar.gd).
; CityMap: 40x20 grid at 16px tiles rendered by grid_manager.gd.
; Remaining panels are structural placeholders for future integration.

[ext_resource type="Script" path="res://game/game_boot.gd" id="1"]
[ext_resource type="Script" path="res://core/chapter_flow.gd" id="2"]
[ext_resource type="Script" path="res://ui/resource_bar.gd" id="3"]
[ext_resource type="Script" path="res://world/grid_manager.gd" id="4"]
[ext_resource type="Script" path="res://ui/gameplay_controller.gd" id="5"]

