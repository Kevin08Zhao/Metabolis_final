[gd_scene load_steps=2 format=3]

; Playable stage host.
;
; The named children are the six regions of section 2 of docs/UI_LAYOUT.md plus
; the city map, each an empty Control at its documented rectangle. GameAssembly
; builds the systems and the panels and puts each panel into the region named
; for it, so the regions stay empty here and are filled at runtime.
;
; This scene is what SceneRouter loads for the game route.

[ext_resource type="Script" path="res://game/game_assembly.gd" id="1"]

[node name="Game" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="CityMap" type="Control" parent="."]
offset_top = 40.0
offset_right = 640.0
offset_bottom = 360.0

[node name="ResourceStatusBar" type="Control" parent="."]
offset_right = 640.0
offset_bottom = 16.0

[node name="DevelopmentTimeline" type="Control" parent="."]
offset_top = 16.0
offset_right = 640.0
offset_bottom = 24.0

[node name="TaskOperationsPanel" type="Control" parent="."]
offset_top = 24.0
offset_right = 608.0
offset_bottom = 40.0

[node name="OrganArchiveButton" type="Control" parent="."]
offset_left = 608.0
offset_top = 24.0
offset_right = 624.0
offset_bottom = 40.0

[node name="ChapterRecapButton" type="Control" parent="."]
offset_left = 624.0
offset_top = 24.0
offset_right = 640.0
offset_bottom = 40.0

[node name="GuidanceLayer" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="GameAssembly" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1")
