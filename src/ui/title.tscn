[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/title_intro.gd" id="1_intro"]

; Opening title scene.
;
; Six independent 320x180 layers play once for eight seconds at 8 FPS. The
; existing background slot remains as a fallback if any sequence is unavailable.
; SceneRouter still owns and dynamically creates the save-aware menu entries;
; title_intro.gd only presents and reveals them.
;
; The title offers continue, new game and chapter select, with chapter select
; gated on a finished stage that can really be entered. New Game is the single
; entry into the body-system city; the former separate Body-System button is
; retired.

[node name="Title" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_intro")

[node name="Background" type="TextureRect" parent="." groups=["title_background"]]
layout_mode = 1
anchors_preset = 15
