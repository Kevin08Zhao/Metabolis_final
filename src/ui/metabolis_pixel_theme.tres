; Project-wide UI theme.
;
; Deliberately carries no font of its own. The pixel font is generated by
; tools/build_pixel_font.py into art/fonts/, which sits outside the Godot
; project root, so no ext_resource here can reach it. UiTheme
; (res://core/ui_theme.gd) loads the font at startup and injects it into this
; resource. Registered as gui/theme/custom in project.godot, which every
; Control consults regardless of where it sits in the scene tree.

[gd_resource type="Theme" format=3]

[resource]
Label/colors/font_color = Color(0.909804, 0.862745, 0.811765, 1)
Label/colors/font_outline_color = Color(0.0784314, 0.0588235, 0.113725, 1)
Button/colors/font_color = Color(0.909804, 0.862745, 0.811765, 1)
Button/colors/font_hover_color = Color(0.694118, 1, 0.819608, 1)
Button/colors/font_pressed_color = Color(0.866667, 0.678431, 0.494118, 1)
Button/colors/font_focus_color = Color(0.694118, 1, 0.819608, 1)
Button/colors/font_disabled_color = Color(0.505882, 0.458824, 0.509804, 1)
Button/colors/font_outline_color = Color(0.0784314, 0.0588235, 0.113725, 1)
